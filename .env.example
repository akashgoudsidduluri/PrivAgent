# PrivAgent Environment Configuration
# SIH26171 — On-device Visual Perception for Light-weight Browser Agents

# Local Demo Server
DEMO_PORT=4173
DEMO_HOST=localhost

# Backend Settings (Agent Safety API)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010
ENVIRONMENT=development

# Privacy Engine Options
PRIVAGENT_DEFAULT_REDACTION_MODE=blackout # options: blackout, blur, mask
PRIVAGENT_STRICT_LOCAL_BOUNDARY=true

# Reasoner Provider Configuration (backend only — never exposed to client or browser)
REASONER_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30

# Optional Reasoner Fallback Provider
REASONER_FALLBACK_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_TIMEOUT_SECONDS=45
