{
  "name": "privagent",
  "version": "0.1.0",
  "private": true,
  "description": "PrivAgent: On-device Visual Perception & Privacy Engine for Lightweight Browser Agents (SIH26171, ISRO)",
  "scripts": {
    "dev:extension": "vite build --config extension/vite.config.ts --watch",
    "build:extension": "vite build --config extension/vite.config.ts && cross-env VITE_BUILD_TARGET=contentScript vite build --config extension/vite.config.ts",
    "build": "npm run build:extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "cd backend && python -m pytest tests/ -v",
    "backend": "python backend/run.py",
    "demo": "python demo/synthetic-banking-site/server.py",
    "demo:shopping": "python demo/shopping-fixture/server.py",
    "demo:node": "node demo/synthetic-banking-site/server.js",
    "demo:canvas": "python demo/canvas-privacy-site/server.py",
    "dev": "vite frontend",
    "dev:frontend": "vite frontend",
    "dev:backend": "python backend/run.py",
    "build:frontend": "vite build frontend"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.9",
    "cross-env": "^10.1.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "keywords": [
    "privacy",
    "browser-agent",
    "on-device-ai",
    "sih2026",
    "isro",
    "dom-redaction"
  ],
  "author": "PrivAgent Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "tesseract.js": "^5.1.1"
  }
}
